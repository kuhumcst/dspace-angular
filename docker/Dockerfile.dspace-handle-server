ARG DSPACE_IMAGE=ufal/dspace:dspace-7_x
FROM ${DSPACE_IMAGE}

# Oracle Berkeley DB Java Edition is required by handle-9.3.2.jar
# (net.handle.server.HandleServer.initTxnQueue) but is absent from the
# ufal/dspace image because Oracle publishes it only from their own Maven
# repository (download.oracle.com/maven), not Maven Central, and the image
# build silently drops it.  Adding it here means no host-side JAR mount is
# needed and the handle server starts cleanly on container launch.
#
# Version pinned to match the com.sleepycat:je dependency declared in
# DSpace 7.6.x dspace-api/pom.xml.
ARG JE_VERSION=7.5.11
RUN curl -fsSL -o /dspace/lib/je-${JE_VERSION}.jar \
    https://download.oracle.com/maven/com/sleepycat/je/${JE_VERSION}/je-${JE_VERSION}.jar

# Distrust eMudhra (emSign) roots. In October 2026 the private keys of eight
# eMudhra intermediates turned out to be trivially derivable, so anyone can
# mint certificates that chain to these roots; Mozilla and Chrome have
# distrusted them. Remove them from both trust stores in the image: the OS
# bundle and the JDK's own cacerts (Temurin keeps a separate copy). The
# final checks fail the build if any emSign root is still present.
USER root
RUN sed -i -E 's|^(mozilla/emSign_[^ ]+\.crt)$|!\1|' /etc/ca-certificates.conf \
 && update-ca-certificates --fresh \
 && for a in \
      'cn=emsign_root_ca_-_g1,o=emudhra_technologies_limited,ou=emsign_pki,c=in' \
      'cn=emsign_ecc_root_ca_-_g3,o=emudhra_technologies_limited,ou=emsign_pki,c=in' \
      'cn=emsign_root_ca_-_c1,o=emudhra_inc,ou=emsign_pki,c=us' \
      'cn=emsign_ecc_root_ca_-_c3,o=emudhra_inc,ou=emsign_pki,c=us'; do \
      "${JAVA_HOME}/bin/keytool" -delete -cacerts -storepass changeit -alias "$a"; \
    done \
 && ! "${JAVA_HOME}/bin/keytool" -list -v -cacerts -storepass changeit | grep -qi emsign \
 && ! ls /etc/ssl/certs | grep -qi emsign \
 && ! awk -v cmd='openssl x509 -noout -subject' \
        '/BEGIN/{c=""} {c=c $0 "\n"} /END/{print c | cmd; close(cmd)}' \
        /etc/ssl/certs/ca-certificates.crt | grep -qi emsign
USER dspace
