# CLARIN-DSpace production configuration template
# Copy to .env and fill in values before starting the stack.
# .env is gitignored; this file is the tracked reference.

# Instance identifier — used as a suffix on container names and port numbers.
# Using 1 avoids port conflicts with any other parallel DSpace instance.
INSTANCE=1

# Host configuration
DSPACE_HOST=repository.clarin.dk
DSPACE_SSL=true

# HOST_IP controls which address Docker binds the published ports to.
#
# Must be 127.0.0.1. Docker-published ports bypass the host firewall, so
# 0.0.0.0 would expose Postgres (5431, default password), Solr (8981, no auth),
# Tomcat (8081) and the Angular SSR server (4001) on the public interface.
#
# The Handle.net server's native port 2641 (tcp/udp) does need to be public —
# the global resolvers connect to it directly and nginx cannot proxy it — but
# that is handled separately in docker-compose.override.yml, which binds only
# 2641 to 0.0.0.0. Public HTTP(S) traffic goes through nginx on the host.
HOST_IP=127.0.0.1

# URL namespaces
DSPACE_REST_NAMESPACE=/server
DSPACE_UI_NAMESPACE=/

# Composed URLs (via nginx reverse proxy)
REST_URL=https://${DSPACE_HOST}${DSPACE_REST_NAMESPACE}
UI_URL=https://${DSPACE_HOST}${DSPACE_UI_NAMESPACE}

# Docker image configuration
DOCKER_OWNER=ufal
DSPACE_VER=dspace-7_x
DSPACE_UI_IMAGE=${DOCKER_OWNER}/dspace-angular:$DSPACE_VER
DSPACE_REST_IMAGE=${DOCKER_OWNER}/dspace:$DSPACE_VER

# Enable Docker BuildKit for faster, more efficient builds
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Production mode (not dev)
# FE_CMD not set = uses default pm2-runtime
